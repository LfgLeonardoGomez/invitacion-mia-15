# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = all admin operations disabled. Never put this value in frontend code.
MIA_ADMIN_API_KEY=

# Separate private key for recoverable invitation links. Keep a secure backup
# outside SQLite; losing it prevents copying encrypted links, not opening URLs.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required for create/rotate/copy-link operations, never put it in the frontend.
MIA_LINK_ENCRYPTION_KEY=

# Private persistent path; default is backend/data/invitations.sqlite3.
# Use a local disk, never a public web directory or network filesystem.
MIA_DATABASE_PATH=

# Comma-separated explicit origins. No wildcard; admin sessions use cookies.
# Example for local preview only: http://127.0.0.1:5173
MIA_ALLOWED_ORIGINS=

# Keep false for public deployment.
MIA_ENABLE_DOCS=false
