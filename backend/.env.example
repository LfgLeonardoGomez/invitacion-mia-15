# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = all admin operations disabled. Never put this value in frontend code.
MIA_ADMIN_API_KEY=

# Private persistent path; default is backend/data/invitations.sqlite3.
# Use a local disk, never a public web directory or network filesystem.
MIA_DATABASE_PATH=

# Comma-separated explicit origins. No wildcard, credentials/cookies not used.
# Example for local preview only: http://127.0.0.1:5500
MIA_ALLOWED_ORIGINS=

# Keep false for public deployment.
MIA_ENABLE_DOCS=false
